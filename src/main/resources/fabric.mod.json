{
	"schemaVersion": 1,
	"id": "timetick",
	"version": "${version}",
	"name": "TimeTick",
	"description": "This mod saves and simulates the time passed on an unloaded chunk. Trees and crops will be grown when you come back to a chunk after a long time",
	"authors": [
		"Luzyvert"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/timetick",
		"sources": "https://github.com/Luzyvert/timetick/tree/26.1"
	},
	"license": "MIT",
	"icon": "assets/timetick/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.luzyvert.timetick.TimeTick"
		],
		"client": [
			"com.luzyvert.timetick.TimeTickClient"
		],
		"fabric-datagen": [
			"com.luzyvert.timetick.TimeTickDataGenerator"
		],
		"cardinal-components-chunk": [
			"com.luzyvert.timetick.TimeTickChunkComponents"
		]
	},
	"custom": {
		"cardinal-components": [
			"timetick:cached_chunk_data"
		]
	},
	"mixins": [
		"timetick.mixins.json",
		{
			"config": "timetick.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.5",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*"
	}
}